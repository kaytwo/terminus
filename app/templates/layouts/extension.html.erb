<!DOCTYPE html>

<html lang="en">
  <head>
    <base href="<%= Hanami.app[:settings].api_uri %>/">
    <meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no">

    <title><%= content_for :title %></title>

    <meta charset="utf-8">
    <meta name="description" content="A TRMNL server.">
    <meta name="author" content="TRMNL">

    <%= tag.link title: "TRMNL: Stylesheet",
                 rel: :stylesheet,
                 href: "/uploads/trmnl/css/plugins.css" %>

    <style type="text/css">
      .trmnl {
        align-items: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
    </style>

    <%= javascript_tag "/uploads/trmnl/js/plugins.js" %>
  </head>

  <body class="trmnl">
    <%= yield %>
  </body>
</html>

